<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp"
    android:background="@color/background">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Prayer Journal" android:textSize="28sp"
        android:textColor="@color/gold" android:textStyle="bold"
        android:layout_marginBottom="20dp" />
    <EditText android:id="@+id/journalEntry"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="top"
        android:hint="Write your prayers, praises, and reflections here..."
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:background="@color/card_background"
        android:padding="16dp" android:inputType="textMultiLine"
        android:layout_marginBottom="20dp" />
    <Button android:id="@+id/saveButton"
        android:layout_width="match_parent" android:layout_height="60dp"
        android:text="Save Journal Entry" android:textSize="18sp"
        android:backgroundTint="@color/gold" android:textColor="@color/background" />
</LinearLayout>

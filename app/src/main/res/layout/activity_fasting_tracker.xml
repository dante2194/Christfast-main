<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Fasting Timer" android:textSize="28sp"
            android:textColor="@color/gold" android:textStyle="bold"
            android:layout_marginTop="20dp" android:layout_marginBottom="30dp" />

        <TextView android:id="@+id/timerText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="00:00:00" android:textSize="48sp"
            android:textColor="@color/text_primary" android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView android:id="@+id/statusText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ready to fast" android:textSize="18sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="24dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="FAST DURATION" android:textSize="12sp"
            android:textColor="@color/gold" android:textStyle="bold"
            android:letterSpacing="0.15" android:layout_marginBottom="8dp" />

        <RadioGroup android:id="@+id/durationGroup"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="24dp">
            <RadioButton android:id="@+id/radio16"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="16 h" android:textColor="@color/text_primary"
                android:buttonTint="@color/gold" android:layout_marginEnd="12dp"
                android:checked="true" />
            <RadioButton android:id="@+id/radio18"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="18 h" android:textColor="@color/text_primary"
                android:buttonTint="@color/gold" android:layout_marginEnd="12dp" />
            <RadioButton android:id="@+id/radio24"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="24 h" android:textColor="@color/text_primary"
                android:buttonTint="@color/gold" />
        </RadioGroup>

        <TextView android:layout_width="260dp" android:layout_height="wrap_content"
            android:text="A quiet notification will show your remaining time while the fast is running."
            android:textSize="13sp" android:textColor="@color/text_secondary"
            android:gravity="center" android:layout_marginBottom="24dp" />

        <Button android:id="@+id/startFastButton"
            android:layout_width="240dp" android:layout_height="60dp"
            android:text="Start Fast" android:textSize="18sp"
            android:backgroundTint="@color/gold" android:textColor="@color/background"
            android:layout_marginBottom="12dp" />

        <Button android:id="@+id/stopFastButton"
            android:layout_width="240dp" android:layout_height="60dp"
            android:text="Stop Fast" android:textSize="18sp"
            android:backgroundTint="@color/error" android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
